# --- Supabase (public) ---------------------------------------------------
# Found in Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The "publishable" key (Supabase's current naming for the client-safe key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (server-only, never expose to the client) --------------------
# The "secret" key (Supabase's current naming for the privileged key that
# bypasses Row Level Security). Server-only — never prefix this with
# NEXT_PUBLIC_, never reference it outside src/lib/config.server.ts and the
# modules that import that.
SUPABASE_SECRET_KEY=your-secret-key

# --- Database (Drizzle) ------------------------------------------------------
# Pooled connection (used by the app at runtime, e.g. Supabase's connection pooler on port 6543).
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# Direct, non-pooled connection (used by drizzle-kit migrations).
DIRECT_URL=postgresql://postgres:password@localhost:5432/postgres

# --- Security (server-only) -------------------------------------------------
# Generate with: openssl rand -hex 32
API_KEY_HASH_PEPPER=
# Generate with: openssl rand -hex 32
CRON_SECRET=
